
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tribulaciones-web",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tribulaciones",
      "database_id": "7a14068c-db18-4041-8f37-3fd0bfa02a3a"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "albaprieto1406@gmail.com",
    "ADMIN_NAME": "Alba Prieto",
    "MAIL_FROM": "Las Tribulaciones de Sara <onboarding@resend.dev>",
    "SITE_URL": "https://tribulaciones-web.aprstudio.workers.dev"
  },
  "triggers": {
    "crons": ["0 1 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
