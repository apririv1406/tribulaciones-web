{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tribulaciones",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tribulaciones",
      "database_id": "PON_AQUI_EL_ID_DE_LA_BASE_DE_DATOS"
    }
  ],
  "observability": { "enabled": true }
}
